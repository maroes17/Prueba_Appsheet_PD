<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Órdenes de Trabajo — Romanesco</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: 'Arial', sans-serif;
        background: #f0f2f5;
        min-height: 100vh;
        padding: 20px 16px 40px;
    }
    .wrap { max-width: 1180px; margin: 0 auto; }

    .header { display:flex; align-items:center; gap:10px; margin-bottom:20px; flex-wrap:wrap; }
    .header-logo { font-size:18px; font-weight:900; text-transform:uppercase; letter-spacing:1.5px; color:#111; }
    .header-sub  { font-size:10px; letter-spacing:3px; color:#666; text-transform:uppercase; }
    .header-divider { width:1px; height:36px; background:#ccc; margin:0 4px; }
    .header-title { font-size:13px; color:#444; font-weight:bold; text-transform:uppercase; letter-spacing:0.5px; }
    .header-spacer { flex:1; }
    .btn-refrescar {
        background:#1a1a2e; color:white; border:none; border-radius:8px;
        padding:10px 16px; font-size:13px; font-weight:bold; cursor:pointer;
    }
    .btn-refrescar:hover { background:#2d2d4e; }
    .btn-refrescar:disabled { background:#aaa; cursor:not-allowed; }

    /* ── Filtros ── */
    .filtros-card {
        background:white; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.08);
        padding:16px 20px; margin-bottom:20px; display:grid;
        grid-template-columns: repeat(5, 1fr); gap:12px; align-items:end;
    }
    @media (max-width: 900px) { .filtros-card { grid-template-columns: 1fr 1fr; } }
    label { display:block; font-size:11px; text-transform:uppercase; letter-spacing:1px; color:#888; margin-bottom:6px; font-weight:bold; }
    input, select {
        border:1.5px solid #ddd; border-radius:8px; padding:9px 10px;
        font-size:13px; color:#111; outline:none; background:#fafafa; width:100%;
    }
    input:focus, select:focus { border-color:#1a1a2e; background:white; }
    .btn-limpiar {
        background:transparent; border:1.5px dashed #ccc; color:#888;
        border-radius:8px; padding:9px 10px; font-size:12px; cursor:pointer;
    }
    .btn-limpiar:hover { border-color:#1a1a2e; color:#1a1a2e; }

    /* ── Estado ── */
    .estado { padding:12px 16px; border-radius:8px; font-size:13px; margin-bottom:16px; display:none; align-items:center; gap:8px; }
    .estado.visible  { display:flex; }
    .estado.cargando { background:#eef2ff; color:#3730a3; }
    .estado.error    { background:#fef2f2; color:#991b1b; }
    .spinner { width:16px; height:16px; border:2px solid currentColor; border-top-color:transparent; border-radius:50%; animation:spin 0.7s linear infinite; flex-shrink:0; }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* ── KPIs ── */
    .kpi-grid { display:grid; grid-template-columns:repeat(6, 1fr); gap:12px; margin-bottom:20px; }
    @media (max-width: 1000px) { .kpi-grid { grid-template-columns:repeat(3, 1fr); } }
    @media (max-width: 600px)  { .kpi-grid { grid-template-columns:repeat(2, 1fr); } }
    .kpi-box {
        background:white; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.08);
        padding:16px; border-left:3px solid #1a1a2e;
    }
    .kpi-box.destacado { border-left-color:#e67e22; }
    .kpi-label { font-size:10px; text-transform:uppercase; letter-spacing:1px; color:#888; margin-bottom:6px; font-weight:bold; }
    .kpi-valor { font-size:24px; font-weight:900; color:#111; line-height:1.1; }
    .kpi-unidad { font-size:12px; color:#888; font-weight:normal; margin-left:2px; }

    /* ── Gráficos ── */
    .charts-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    @media (max-width: 900px) { .charts-grid { grid-template-columns:1fr; } }
    .chart-card {
        background:white; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.08);
        padding:20px; margin-bottom:16px;
    }
    .chart-card.full { grid-column:1/-1; }
    .chart-titulo { font-size:11px; text-transform:uppercase; letter-spacing:1px; color:#888; font-weight:bold; margin-bottom:14px; }
    .chart-canvas-wrap { position:relative; height:280px; }

    /* ── Tabla top vehículos ── */
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th { text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:1px; color:#888; padding:8px 10px; border-bottom:2px solid #eee; }
    td { padding:10px; border-bottom:1px solid #f0f0f0; color:#333; }
    tr:hover td { background:#fafbfc; }
    .badge { display:inline-block; padding:3px 8px; border-radius:20px; font-size:11px; font-weight:bold; }
    .badge.cerrada  { background:#e8f5e9; color:#1b5e20; }
    .badge.otro     { background:#fff3e0; color:#8a4b00; }
</style>
</head>
<body>
<div class="wrap">

    <div class="header">
        <div>
            <div class="header-logo">Romanesco</div>
            <div class="header-sub">Transportes</div>
        </div>
        <div class="header-divider"></div>
        <div class="header-title">Dashboard de<br>Órdenes de Trabajo</div>
        <div class="header-spacer"></div>
        <button class="btn-refrescar" id="btn-refrescar" onclick="cargarMetricas()">Actualizar</button>
    </div>

    <!-- Filtros -->
    <div class="filtros-card">
        <div>
            <label>Desde</label>
            <input type="date" id="f-desde" onchange="cargarMetricas()">
        </div>
        <div>
            <label>Hasta</label>
            <input type="date" id="f-hasta" onchange="cargarMetricas()">
        </div>
        <div>
            <label>Taller</label>
            <select id="f-taller" onchange="cargarMetricas()"><option value="">Todos</option></select>
        </div>
        <div>
            <label>Tipo de máquina</label>
            <select id="f-tipo" onchange="cargarMetricas()"><option value="">Todos</option></select>
        </div>
        <div>
            <label>Estado OT</label>
            <select id="f-estado" onchange="cargarMetricas()"><option value="">Todos</option></select>
        </div>
        <div style="grid-column:1/-1;">
            <button class="btn-limpiar" onclick="limpiarFiltros()">✕ Limpiar filtros</button>
        </div>
    </div>

    <div class="estado cargando" id="estado-cargando"><div class="spinner"></div> Cargando métricas...</div>
    <div class="estado error" id="estado-error">⚠ No se pudieron cargar los datos. Revisa la URL del Apps Script.</div>

    <!-- KPIs -->
    <div class="kpi-grid" id="kpi-grid">
        <div class="kpi-box"><div class="kpi-label">Total OT</div><div class="kpi-valor" id="kpi-total">—</div></div>
        <div class="kpi-box"><div class="kpi-label">OT abiertas</div><div class="kpi-valor" id="kpi-abiertas">—</div></div>
        <div class="kpi-box"><div class="kpi-label">OT cerradas</div><div class="kpi-valor" id="kpi-cerradas">—</div></div>
        <div class="kpi-box destacado"><div class="kpi-label">Costo total</div><div class="kpi-valor" id="kpi-costo-total">—</div></div>
        <div class="kpi-box"><div class="kpi-label">Costo promedio / OT</div><div class="kpi-valor" id="kpi-costo-prom">—</div></div>
        <div class="kpi-box"><div class="kpi-label">Días promedio resolución</div><div class="kpi-valor" id="kpi-dias">—<span class="kpi-unidad">días</span></div></div>
    </div>

    <!-- Gráficos -->
    <div class="chart-card full">
        <div class="chart-titulo">Gastos mensuales (Mano de Obra + Repuestos)</div>
        <div class="chart-canvas-wrap"><canvas id="chart-mensual"></canvas></div>
    </div>

    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-titulo">Costo total por marca</div>
            <div class="chart-canvas-wrap"><canvas id="chart-marca"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="chart-titulo">Costo total por taller</div>
            <div class="chart-canvas-wrap"><canvas id="chart-taller"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="chart-titulo">OT por estado</div>
            <div class="chart-canvas-wrap"><canvas id="chart-estado"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="chart-titulo">Costo por tipo de máquina</div>
            <div class="chart-canvas-wrap"><canvas id="chart-tipo-maquina"></canvas></div>
        </div>
    </div>

    <div class="chart-card full">
        <div class="chart-titulo">Top 10 vehículos por costo acumulado</div>
        <table>
            <thead>
                <tr><th>OT</th><th>Patente</th><th>Marca / Modelo</th><th>Taller</th><th>Estado</th><th>Costo</th></tr>
            </thead>
            <tbody id="tabla-top-vehiculos"></tbody>
        </table>
    </div>

</div>

<script>
    // ⚠ Reemplaza con la URL /exec de tu Web App de Apps Script
    const APPS_SCRIPT_URL = "https://script.google.com/macros/s/TU_ID_DE_DESPLIEGUE/exec";

    let charts = {};

    // ── JSONP helper (mismo patrón que el dashboard de Combustible) ──────
    function jsonp(url) {
        return new Promise((resolve, reject) => {
            const callbackName = "cb_" + Math.random().toString(36).slice(2);
            const script = document.createElement("script");
            const limpiar = () => { delete window[callbackName]; script.remove(); };

            window[callbackName] = (data) => { limpiar(); resolve(data); };
            script.onerror = () => { limpiar(); reject(new Error("Fallo de red al consultar Apps Script")); };

            const separador = url.includes("?") ? "&" : "?";
            script.src = `${url}${separador}callback=${callbackName}`;
            document.body.appendChild(script);
        });
    }

    function formatoMoneda(valor) {
        return "$" + Number(valor || 0).toLocaleString("es-CL", { maximumFractionDigits: 0 });
    }

    function mostrarEstado(tipo) {
        ["cargando", "error"].forEach(t => document.getElementById(`estado-${t}`).classList.remove("visible"));
        if (tipo) document.getElementById(`estado-${tipo}`).classList.add("visible");
    }

    function poblarSelect(id, valores, actual) {
        const select = document.getElementById(id);
        const seleccionActual = actual || select.value;
        select.innerHTML = '<option value="">Todos</option>' +
            valores.map(v => `<option value="${v}">${v}</option>`).join("");
        select.value = seleccionActual;
    }

    function obtenerFiltros() {
        return {
            accion: "metricas",
            fechaDesde: document.getElementById("f-desde").value,
            fechaHasta: document.getElementById("f-hasta").value,
            taller: document.getElementById("f-taller").value,
            tipoMaquina: document.getElementById("f-tipo").value,
            estado: document.getElementById("f-estado").value,
        };
    }

    function limpiarFiltros() {
        ["f-desde", "f-hasta", "f-taller", "f-tipo", "f-estado"].forEach(id => {
            document.getElementById(id).value = "";
        });
        cargarMetricas();
    }

    async function cargarMetricas() {
        mostrarEstado("cargando");
        document.getElementById("btn-refrescar").disabled = true;

        try {
            const params = obtenerFiltros();
            const query = Object.entries(params)
                .filter(([, v]) => v !== "" && v !== undefined)
                .map(([k, v]) => `${k}=${encodeURIComponent(v)}`)
                .join("&");

            const resp = await jsonp(`${APPS_SCRIPT_URL}?${query}`);
            if (!resp.ok) throw new Error(resp.error || "Error desconocido");

            renderizarDashboard(resp.data);
            mostrarEstado(null);
        } catch (err) {
            console.error(err);
            mostrarEstado("error");
        } finally {
            document.getElementById("btn-refrescar").disabled = false;
        }
    }

    function renderizarDashboard(data) {
        // Selects de filtro (se pueblan con los valores reales del Sheet)
        poblarSelect("f-taller", data.filtrosDisponibles.talleres);
        poblarSelect("f-tipo", data.filtrosDisponibles.tiposMaquina);
        poblarSelect("f-estado", data.filtrosDisponibles.estados);

        // KPIs
        const k = data.kpis;
        document.getElementById("kpi-total").textContent = k.totalOT;
        document.getElementById("kpi-abiertas").textContent = k.otAbiertas;
        document.getElementById("kpi-cerradas").textContent = k.otCerradas;
        document.getElementById("kpi-costo-total").textContent = formatoMoneda(k.costoTotal);
        document.getElementById("kpi-costo-prom").textContent = formatoMoneda(k.costoPromedioPorOT);
        document.getElementById("kpi-dias").innerHTML = `${k.diasPromedioResolucion}<span class="kpi-unidad">días</span>`;

        // Gráficos
        renderLineChart("chart-mensual", data.gastosPorMes.map(m => m.mes), data.gastosPorMes.map(m => m.costo));
        renderBarChart("chart-marca", data.costoPorMarca.map(m => m.etiqueta), data.costoPorMarca.map(m => m.costo));
        renderBarChart("chart-taller", data.costoPorTaller.map(m => m.etiqueta), data.costoPorTaller.map(m => m.costo));
        renderDonutChart("chart-estado", data.otPorEstado.map(m => m.etiqueta), data.otPorEstado.map(m => m.cantidadOT));
        renderBarChart("chart-tipo-maquina", data.otPorTipoMaquina.map(m => m.etiqueta), data.otPorTipoMaquina.map(m => m.costo));

        // Tabla top vehículos
        const tbody = document.getElementById("tabla-top-vehiculos");
        tbody.innerHTML = data.topVehiculos.map(v => `
            <tr>
                <td>${v.nroOT ?? v.idOT}</td>
                <td>${v.patente || "—"}</td>
                <td>${v.marca || "—"} ${v.modelo || ""}</td>
                <td>${v.taller || "—"}</td>
                <td><span class="badge ${/cerrad/i.test(v.estadoOT) ? "cerrada" : "otro"}">${v.estadoOT || "—"}</span></td>
                <td>${formatoMoneda(v.costoTotal)}</td>
            </tr>
        `).join("") || `<tr><td colspan="6" style="text-align:center;color:#999;">Sin datos para los filtros aplicados</td></tr>`;
    }

    // ── Helpers Chart.js ──────────────────────────────────────────────
    const PALETA = ["#1a1a2e", "#e67e22", "#3730a3", "#16a34a", "#991b1b", "#0891b2", "#78350f", "#7e22ce"];

    function destruirSiExiste(id) {
        if (charts[id]) { charts[id].destroy(); delete charts[id]; }
    }

    function renderLineChart(id, labels, valores) {
        destruirSiExiste(id);
        charts[id] = new Chart(document.getElementById(id), {
            type: "line",
            data: { labels, datasets: [{ label: "Gasto", data: valores, borderColor: "#1a1a2e", backgroundColor: "rgba(26,26,46,0.08)", fill: true, tension: 0.3 }] },
            options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } } }
        });
    }

    function renderBarChart(id, labels, valores) {
        destruirSiExiste(id);
        charts[id] = new Chart(document.getElementById(id), {
            type: "bar",
            data: { labels, datasets: [{ data: valores, backgroundColor: PALETA[0] }] },
            options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } } }
        });
    }

    function renderDonutChart(id, labels, valores) {
        destruirSiExiste(id);
        charts[id] = new Chart(document.getElementById(id), {
            type: "doughnut",
            data: { labels, datasets: [{ data: valores, backgroundColor: PALETA }] },
            options: { responsive:true, maintainAspectRatio:false }
        });
    }

    // Carga inicial
    cargarMetricas();
</script>
</body>
</html>
